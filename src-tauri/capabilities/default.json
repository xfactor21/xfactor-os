{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-workspace",
  "description": "Least-privilege permissions for the primary xFactor.OS workspace window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-dir",
    "fs:allow-stat",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "core:webview:allow-create-webview-window"
  ]
}
